table Monthly
	column month
		dataType: string
		sourceColumn: month
		summarizeBy: none

	column Revenue_CLP
		dataType: double
		sourceColumn: Revenue_CLP
		summarizeBy: sum

	column BatchCost_CLP
		dataType: double
		sourceColumn: BatchCost_CLP
		summarizeBy: sum

	column WasteCost_CLP
		dataType: double
		sourceColumn: WasteCost_CLP
		summarizeBy: sum

	measure 'Revenue CLP' = SUM(Monthly[Revenue_CLP])
		formatString: #,0

	measure 'Waste rate' = DIVIDE(SUM(Monthly[WasteCost_CLP]),SUM(Monthly[BatchCost_CLP]))
		formatString: 0.0%

	partition Monthly = m
		mode: import
		source =
			let
			 Source = Csv.Document(Binary.FromText("",BinaryEncoding.Base64),[Delimiter=",",Columns=4,Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
			 Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
			 Typed = Table.TransformColumnTypes(Headers,{{"month",type text},{"Revenue_CLP",type number},{"BatchCost_CLP",type number},{"WasteCost_CLP",type number}})
			in Typed
