table Category
	column category
		dataType: string
		sourceColumn: category
		summarizeBy: none

	column Revenue_CLP
		dataType: double
		sourceColumn: Revenue_CLP
		summarizeBy: sum

	column BatchCost_CLP
		dataType: double
		sourceColumn: BatchCost_CLP
		summarizeBy: sum

	column GrossProfit_CLP
		dataType: double
		sourceColumn: GrossProfit_CLP
		summarizeBy: sum

	column WasteCost_CLP
		dataType: double
		sourceColumn: WasteCost_CLP
		summarizeBy: sum

	measure 'Waste CLP' = SUM(Category[WasteCost_CLP])
		formatString: #,0

	measure 'Gross margin' = DIVIDE(SUM(Category[GrossProfit_CLP]),SUM(Category[Revenue_CLP]))
		formatString: 0.0%

	partition Category = m
		mode: import
		source =
			let
			 Source = Csv.Document(Binary.FromText("",BinaryEncoding.Base64),[Delimiter=",",Columns=5,Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
			 Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
			 Typed = Table.TransformColumnTypes(Headers,{{"category",type text},{"Revenue_CLP",type number},{"BatchCost_CLP",type number},{"GrossProfit_CLP",type number},{"WasteCost_CLP",type number}})
			in Typed
